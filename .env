# Puerto del servidor (API + archivos estáticos en producción)
PORT=8787
# Carpeta donde se guardan grupos y resultados anónimos (JSON)
DATA_DIR=./data

# ── Asistente con IA (opcional) ────────────────────────────────────────────
# Sin ninguna clave, el asistente responde solo con la guía verificada (sin IA).
# Proveedor: "anthropic" o "deepseek". Si lo dejas vacío, se usa el que tenga clave.
AI_PROVIDER=

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_VERSION=2023-06-01

# DeepSeek (formato compatible con OpenAI)
DEEPSEEK_API_KEY=sk-537b20b84fe14041bae17ac6ce1dbde3
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Orígenes permitidos para CORS en desarrollo (separados por coma). Vacío = mismo origen.
ALLOWED_ORIGINS=
